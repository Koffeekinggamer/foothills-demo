---
import '../styles/tokens.css';
import '../styles/components.css';
import '../styles/demo.css';
import { getImage } from 'astro:assets';
import Icon from '../components/Icon.astro';
import OpenStatus from '../components/OpenStatus.astro';
import { SITE, HOURS } from '../data/site';
import { withBase } from '../data/url';
import { img } from '../data/img';
import logoInk from '../assets/img/logo-ink.png';
import logoPaper from '../assets/img/logo-paper.png';

interface Props {
  title: string; description: string; path: string; nav?: string; bodyClass?: string; product?: string;
  lcp?: { name: string; sizes: string; widths?: number[] };
  jsonld?: object[];
}
const { title, description, path, nav = '', bodyClass = '', product, lcp, jsonld = [] } = Astro.props;

let preload: string | undefined;
if (lcp) {
  const src = img(lcp.name);
  const want = lcp.widths ?? [400, 800, 1200, 1600];
  const ws = want.filter((w) => w <= src.width);
  if (!ws.length || (src.width > ws[ws.length - 1] && want.some((w) => w > src.width))) ws.push(src.width);
  const r = await getImage({ src, widths: ws, sizes: lcp.sizes, format: 'avif' });
  preload = r.srcSet.attribute;
}
const logoInkW = await getImage({ src: logoInk, width: 264, format: 'webp' });
const logoPaperW = await getImage({ src: logoPaper, width: 264, format: 'webp' });

const NAV = [
  ['Dining', withBase('/collections/amish-dining-room-furniture')], ['Bedroom', withBase('/collections/bedroom-sets')], ['Living', withBase('/collections/living-room-furniture')],
  ['Outdoor', withBase('/collections/amish-outdoor-furniture')], ['Benches', withBase('/collections/dining-benches')], ['Custom Cabinetry', withBase('/pages/cabinetry-page')],
  ['Visit', withBase('/pages/contact-us')],
];
const dayKeys = ['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'];
const pad = (m: number) => `${String(Math.floor(m / 60)).padStart(2, '0')}:${String(m % 60).padStart(2, '0')}`;
const store = {
  '@context': 'https://schema.org', '@type': 'FurnitureStore', '@id': `${SITE.origin}/#store`,
  name: SITE.name, url: SITE.origin, telephone: SITE.tel, image: `${SITE.origin}/cdn/shop/files/storefront.jpg`,
  logo: `${SITE.origin}/cdn/shop/files/logo.png`, priceRange: '$$',
  address: { '@type': 'PostalAddress', streetAddress: SITE.street, addressLocality: SITE.city, addressRegion: SITE.region, postalCode: SITE.zip, addressCountry: 'US' },
  geo: { '@type': 'GeoCoordinates', latitude: SITE.geo.lat, longitude: SITE.geo.lng },
  hasMap: SITE.directions,
  openingHoursSpecification: Object.entries(HOURS).filter(([, h]) => h).map(([d, h]) => ({ '@type': 'OpeningHoursSpecification', dayOfWeek: dayKeys[+d], opens: pad(h![0]), closes: pad(h![1]) })),
  areaServed: ['Landrum SC', 'Greenville SC', 'Spartanburg SC', 'Tryon NC', 'Asheville NC'],
  sameAs: ['https://www.facebook.com/foothillsamishfurniture', 'https://www.instagram.com/foothillsamishfurniture'],
};
const ld = [store, ...jsonld];
---
<!doctype html>
<html lang="en" data-demo>
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<title>{title}</title>
<meta name="description" content={description} />
<meta name="robots" content="noindex,nofollow" />
<link rel="canonical" href={SITE.origin + path} />
<meta name="theme-color" content="#FAF8F4" />
<link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
<Fragment set:html={`
<!-- TAG SLOT head-1 (live position: early <head>, after verification metas) - fullthrottle.ai Launchpad lptm.js (loads GA4).
     INERT IN DEMO: commented out, placeholder ID.
<script src="https://ftlaunchpad.ai/lptm.js?id=LPTM_ID_PLACEHOLDER" async></script>
-->`} />
<Fragment set:html={`<style>
@font-face{font-family:"Fraunces";src:url("${withBase('/fonts/fraunces-var-latin.woff2')}") format("woff2");font-weight:400 500;font-style:normal;font-display:swap}
@font-face{font-family:"Inter";src:url("${withBase('/fonts/inter-var-latin.woff2')}") format("woff2");font-weight:400 600;font-style:normal;font-display:swap}
</style>`} />
<link rel="preload" href={withBase('/fonts/inter-var-latin.woff2')} as="font" type="font/woff2" crossorigin />
<link rel="preload" href={withBase('/fonts/fraunces-var-latin.woff2')} as="font" type="font/woff2" crossorigin />
{preload && <link rel="preload" as="image" type="image/avif" fetchpriority="high" imagesrcset={preload} imagesizes={lcp!.sizes} />}
{ld.map((o) => <script type="application/ld+json" set:html={JSON.stringify(o)} />)}
<Fragment set:html={`
<!-- TAG SLOT head-2 (live position: Shopify app embed in <head>, deferred) - Omnisend in-shop.js. The only email-signup tool; Constant Contact removed.
     INERT IN DEMO: commented out, placeholder brand ID.
<script src="https://omnisnippet1.com/inshop/launcher-v2.js" defer></script>
<script>window.omnisend=window.omnisend||[];omnisend.push(["brandID","OMNISEND_BRAND_ID_PLACEHOLDER"]);</script>
-->`} />
</head>
<body class={`has-actionbar ${bodyClass}`} data-product={product}>
<Fragment set:html={`<!-- TAG SLOT body-start (live position: first thing in <body>) - GTM <noscript> iframe. INERT IN DEMO.
<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-XXXXXXX" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
-->`} />
<a class="skip" href="#main">Skip to content</a>
<aside class="announce" aria-label="Showroom status">
  <div class="wrap announce__inner announce__inner--status">
    <OpenStatus />
    <a class="announce__addr" href={SITE.directions} target="_blank" rel="noopener" data-track="directions_click" data-cta-location="announce"><span class="announce__addr-long">{SITE.street}, Landrum, SC</span><span class="announce__addr-short">Landrum, SC</span></a>
  </div>
</aside>
<header class="header">
  <div class="wrap header__inner">
    <a class="brand" href={withBase('/')} aria-label="Foothills Amish Furniture, home"><img src={logoInkW.src} width="132" height="41" alt="Foothills Amish Furniture" /></a>
    <nav class="nav" aria-label="Main"><ul>{NAV.map(([n, h]) => <li><a href={h} aria-current={n === nav ? 'page' : undefined}>{n}</a></li>)}</ul></nav>
    <div class="header__actions">
      <a class="header__tel" href={`tel:${SITE.tel}`} data-track="click_to_call" data-cta-location="header"><Icon name="phone" /><span class="header__tel-num tnum">{SITE.telDisplay}</span></a>
      <a class="btn btn--sm header__cta" href={SITE.book} data-track="book_appointment_click" data-cta-location="header">Book a visit</a>
      <button class="icon-btn header__menu" type="button" aria-expanded="false" aria-controls="menu" aria-label="Menu" data-menu-toggle><Icon name="menu" /></button>
    </div>
  </div>
</header>
<div class="sheet" id="menu" hidden>
  <div class="sheet__top"><img src={logoInkW.src} width="132" height="41" alt="" /><button class="icon-btn" type="button" aria-label="Close menu" data-menu-toggle><Icon name="close" /></button></div>
  <nav class="sheet__nav" aria-label="Mobile">{NAV.map(([n, h]) => <a href={h}>{n}<Icon name="arrow" /></a>)}<a href={SITE.book}>Book a visit<Icon name="arrow" /></a></nav>
</div>
<div class="scroll-progress" aria-hidden="true"><span></span></div>

<main id="main"><slot /></main>

<nav class="actionbar" aria-label="Contact the showroom">
  <a href={`tel:${SITE.tel}`} data-track="click_to_call" data-cta-location="actionbar"><Icon name="phone" /><span>Call</span></a>
  <a href={SITE.directions} target="_blank" rel="noopener" data-track="directions_click" data-cta-location="actionbar"><Icon name="pin" /><span>Directions</span></a>
  <a href={SITE.sms} data-podium data-track="text_us_click" data-cta-location="actionbar"><Icon name="chat" /><span>Text</span></a>
  <a class="is-primary" href={SITE.book} data-track="book_appointment_click" data-cta-location="actionbar"><Icon name="cal" /><span>Book</span></a>
</nav>
<button class="podium-facade" type="button" data-podium data-track="text_us_click" data-cta-location="floating"><Icon name="chat" />Text us</button>
<div class="toast" role="status" aria-live="polite" hidden></div>

<footer class="footer on-dark cv">
  <div class="wrap">
    <div class="footer__top">
      <div class="footer__brand">
        <img src={logoPaperW.src} width="132" height="41" alt="Foothills Amish Furniture" loading="lazy" />
        <p>Handcrafted Amish hardwood furniture in Landrum, South Carolina. Family-owned. Delivered nationwide.</p>
      </div>
      <div><h2>Visit</h2><address>{SITE.street}<br />{SITE.city}, {SITE.region} {SITE.zip}</address>
        <p style="margin-top:var(--sp-3)"><a class="tnum" href={`tel:${SITE.tel}`} data-track="click_to_call" data-cta-location="footer">{SITE.telDisplay}</a></p>
        <p style="margin-top:var(--sp-2)"><a class="u-caps" href={SITE.directions} target="_blank" rel="noopener" data-track="directions_click" data-cta-location="footer">Directions</a></p></div>
      <div><h2>Hours</h2><p>Monday–Saturday<br />10 a.m.–5 p.m.</p><p class="muted" style="margin-top:var(--sp-2)">Sunday closed</p></div>
      <div><h2>Explore</h2><ul><li><a href={withBase('/collections/dining-benches')}>Dining benches</a></li><li><a href={withBase('/pages/contact-us')}>Contact &amp; visit</a></li><li><a href={withBase('/pages/book')}>Book an appointment</a></li><li><a href={withBase('/pages/our-story')}>Our story</a></li><li><a href={withBase('/pages/reviews-testimonials')}>Reviews</a></li></ul></div>
      <div class="footer__signup">
        <form class="signup" id="newsletter" action="#" method="post" data-form="email_signup" data-demo-form="Omnisend signup">
          <h2>Sales &amp; new arrivals</h2>
          <p class="muted">A few emails a year from Omnisend. Unsubscribe anytime.</p>
          <label class="sr-only" for="nl-email">Email address</label>
          <div class="signup__row"><input class="input" id="nl-email" name="email" type="email" autocomplete="email" placeholder="Email address" required /><button class="btn btn--light" type="submit">Sign up</button></div>
        </form>
      </div>
    </div>
    <div class="footer__base"><p>© 2026 Foothills Amish Furniture · Design demo, not the live site</p><p><a href={withBase('/pages/privacy-policy')}>Privacy</a> · <a href={withBase('/pages/terms-of-service')}>Terms</a></p></div>
  </div>
</footer>
<script is:inline src={withBase('/site.js')} defer></script>
<Fragment set:html={`
<!-- TAG SLOTS body-end (live position: one loader at the end of <body>, run after window "load", in this order).
     ALL INERT IN DEMO: commented out, placeholder IDs. Removed for good: Constant Contact, on.aws beacon, Sentry, GemPages, Elfsight.
<script>
window.addEventListener('load', function () {
  // 1. Google Tag Manager
  (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.createElement(s);f.async=true;f.src='https://www.googletagmanager.com/gtm.js?id='+i;d.head.appendChild(f);})(window,document,'script','dataLayer','GTM-XXXXXXX');
  // 2. Meta Pixel
  !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,document,'script','https://connect.facebook.net/en_US/fbevents.js');
  fbq('init','META_PIXEL_ID_PLACEHOLDER'); fbq('track','PageView');
  // 3. BrandCDN / Nexstar OTT
  var b=document.createElement('script'); b.async=true; b.src='https://tag.brandcdn.com/autoscript/NEXSTAR_ACCOUNT_PLACEHOLDER/NEXSTAR.js'; document.body.appendChild(b);
  // 4. Podium: NOT auto-loaded any more. site.js loads it on first Text tap (facade) with PODIUM_TOKEN_PLACEHOLDER.
});
</script>
-->`} />
</body>
</html>
