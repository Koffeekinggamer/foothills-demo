---
import Icon from './Icon.astro';
import { REVIEWS } from '../data/site';
const { count = 3, eyebrow = 'Customer reviews', h = 'Worth the trip to Landrum' } = Astro.props as { count?: number; eyebrow?: string; h?: string };
const list = REVIEWS.slice(0, count);
const id = 'rv-' + Math.random().toString(36).slice(2, 7);
---
<section class="section band cv" aria-labelledby={id}>
  <div class="wrap">
    <div class="section-head section-head--row" data-reveal>
      <div><span class="eyebrow">{eyebrow}</span><h2 id={id}>{h}</h2></div>
      <a class="textlink" href="/pages/reviews-testimonials">Read more reviews <span class="arrow" aria-hidden="true">→</span></a>
    </div>
    <ul class="reviews" role="list">
      {list.map((r, i) => (
        <li data-reveal style={`--i:${i}`}>
          <figure>
            <div class="stars" role="img" aria-label="5 out of 5 stars"><Icon name="star" /><Icon name="star" /><Icon name="star" /><Icon name="star" /><Icon name="star" /></div>
            <blockquote><p>“{r.text}”</p></blockquote>
            <figcaption>{r.name}</figcaption>
          </figure>
        </li>
      ))}
    </ul>
  </div>
</section>
