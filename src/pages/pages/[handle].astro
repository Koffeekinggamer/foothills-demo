---
import Base from '../../layouts/Base.astro';
import Img from '../../components/Img.astro';
import Icon from '../../components/Icon.astro';
import OpenStatus from '../../components/OpenStatus.astro';
import Visit from '../../components/Visit.astro';
import Reviews from '../../components/Reviews.astro';
import RoomTiles from '../../components/RoomTiles.astro';
import Blocks from '../../components/Blocks.astro';
import { SITE } from '../../data/site';
import { withBase } from '../../data/url';
import { PAGES, type PageCfg } from '../../data/pagecfg';
import { LOCAL, type LocalPage } from '../../data/local';
import raw from '../../data/pages.json';

type Sec = { h: string; eyebrow?: string | null; paras: string[]; cards: { h: string; eyebrow?: string | null; paras: string[] }[]; faq: { q: string; a: string[] }[] };
type Live = { title: string | null; intro: string[]; sections: Sec[] };
const LIVE = raw as unknown as Record<string, Live>;

export function getStaticPaths() {
  return [
    ...Object.keys(PAGES).map((handle) => ({ params: { handle }, props: { handle } })),
    ...LOCAL.map((l) => ({ params: { handle: l.handle }, props: { handle: l.handle } })),
  ];
}
const { handle } = Astro.props as { handle: string };
const city: LocalPage | undefined = LOCAL.find((l) => l.handle === handle);
const cfg: PageCfg = city
  ? { kind: 'local', group: 'About', crumb: city.crumb, h1: city.h1, eyebrow: city.eyebrow, lede: city.lede, seo: city.seo, description: city.description, hero: city.hero, rooms: true }
  : PAGES[handle];
const live: Live = city ? { title: city.h1, intro: [], sections: city.sections } : LIVE[handle];

// Intro: a short first line is the eyebrow, the first long line is the lede, the rest is body copy.
const isLabel = (t: string) => t.length <= 42 && !/[.!?]$/.test(t);
const intro = [...live.intro];
let eyebrow = cfg.eyebrow; let lede = cfg.lede;
if (intro.length && isLabel(intro[0])) { const e = intro.shift()!; eyebrow ??= e; }
if (!lede && intro.length && !isLabel(intro[0])) lede = intro.shift();
const introRest = intro.filter((t) => !isLabel(t));
const h1 = cfg.h1 ?? live.title ?? cfg.crumb;
const drop = cfg.drop ?? [];
let sections = live.sections.filter((s) => !drop.some((d) => s.h.startsWith(d)));
if (introRest.length) sections = [{ h: '', paras: introRest, cards: [], faq: [] }, ...sections];
// Craftsmanship lists its three values in one paragraph; show them as three cards.
sections = sections.map((s) => {
  const p = s.paras[0] || '';
  const parts = p.split(/\s(?=(?:Integrity|Simplicity|Hard Work):)/);
  if (handle === 'craftsmanship' && parts.length === 3) return { ...s, paras: [], cards: parts.map((x) => { const [h, ...r] = x.split(':'); return { h, paras: [r.join(':').trim()] }; }) };
  return s;
});
const images = [...(cfg.images ?? [])];
const kind = cfg.kind;
const title = cfg.seo ?? `${h1.replace(/,? SC$/, ', SC')} | Foothills Amish Furniture`;
const path = `/pages/${handle}`;
const crumbs = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
  { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.origin + '/' },
  { '@type': 'ListItem', position: 2, name: cfg.crumb, item: SITE.origin + path } ] };
const pageLd: object = kind === 'faq'
  ? { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: sections.flatMap((s) => s.faq).map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a.join(' ') } })) }
  : kind === 'local'
    ? { '@context': 'https://schema.org', '@type': 'FurnitureStore', '@id': `${SITE.origin}/#store`, name: SITE.name, url: SITE.origin + path,
        telephone: SITE.tel, address: { '@type': 'PostalAddress', streetAddress: SITE.street, addressLocality: SITE.city, addressRegion: SITE.region, postalCode: SITE.zip, addressCountry: 'US' },
        areaServed: city ? { '@type': 'City', name: `${city.city}, ${city.region}` } : { '@type': 'City', name: 'Landrum, SC' } }
    : { '@context': 'https://schema.org', '@type': ['our-story', 'why-foothills-amish-furniture', 'craftsmanship', 'careers', 'our-services'].includes(handle) ? 'AboutPage' : 'WebPage', name: h1, url: SITE.origin + path, about: { '@id': `${SITE.origin}/#store` } };
const faqAll = sections.flatMap((s) => s.faq);
const localSecs = sections;
---
<Base title={title} description={cfg.description} path={path} nav={cfg.nav ?? (cfg.group === 'Customize' ? 'Customize' : cfg.group === 'About' ? 'About' : '')} bodyClass={`page-content page-${kind}`}
  lcp={cfg.hero ? { name: cfg.hero[0], sizes: '(min-width:1024px) 600px, 100vw', widths: [400, 800, 1200] } : undefined} jsonld={[pageLd, crumbs]}>

{kind === 'local' ? (
  <Fragment>
  <div class="wrap">
    <nav class="crumbs" aria-label="Breadcrumb"><ol><li><a href={withBase('/')}>Home</a></li><li aria-current="page">{cfg.crumb}</li></ol></nav>
    <header class="page-hero page-hero--split">
      <div><span class="eyebrow eyebrow--rule">{eyebrow ?? 'Landrum, South Carolina'}</span><h1>{h1}</h1>
        {lede && <p class="lede">{lede}</p>}
        <p class="hero__meta"><OpenStatus />{city && <span>{city.drive}</span>}</p>
        <div class="btn-row" style="margin-top:var(--sp-5)"><a class="btn btn--caps" href={SITE.directions} target="_blank" rel="noopener" data-track="directions_click" data-cta-location="lseo_hero">Directions</a><a class="btn btn--caps btn--secondary" href={`tel:${SITE.tel}`} data-track="click_to_call" data-cta-location="lseo_hero">Call {SITE.telDisplay}</a></div></div>
      {cfg.hero && <div class="split__media split__media--room"><Img name={cfg.hero[0]} alt={cfg.hero[1]} sizes="(min-width:1024px) 600px, 100vw" widths={[400, 800, 1200]} eager /></div>}
    </header>
  </div>
  <section class="section" style="padding-top:var(--sp-7)">
    <div class="wrap lseo">
      <article class="prose">
        {localSecs.map((s, i) => (
          <Fragment>
            {s.eyebrow && <span class="eyebrow" style={i === 0 ? 'margin-top:0' : undefined}>{s.eyebrow}</span>}
            {s.h && <h2 style={i === 0 ? 'margin-top:0' : s.eyebrow ? 'margin-top:var(--sp-2)' : undefined}>{s.h}</h2>}
            <Blocks s={s} list={cfg.lists?.[s.h]} cardsAs="prose" />
          </Fragment>
        ))}
      </article>
      <aside aria-label="Showroom details">
        <div class="infocard">
          <h2 class="h3">Plan your visit</h2>
          <dl>
            <div><dt>Showroom</dt><dd>{SITE.street}<br />{SITE.city}, {SITE.region} {SITE.zip}</dd></div>
            {city && <div><dt>From {city.city}</dt><dd>{city.drive}</dd></div>}
            <div><dt>Hours</dt><dd>Mon–Sat, 10 a.m.–5 p.m.<br />Sunday closed</dd></div>
            <div><dt>Phone</dt><dd><a class="link tnum" href={`tel:${SITE.tel}`} data-track="click_to_call" data-cta-location="lseo_card">{SITE.telDisplay}</a></dd></div>
          </dl>
          <a class="btn btn--caps btn--block" href={SITE.book} data-track="book_appointment_click" data-cta-location="lseo_card">Book an in-store appointment</a>
          <a class="btn btn--caps btn--secondary btn--block" href={SITE.directions} target="_blank" rel="noopener" data-track="directions_click" data-cta-location="lseo_card">Directions</a>
        </div>
      </aside>
    </div>
  </section>
  {cfg.rooms && <RoomTiles />}
  </Fragment>
) : (
  <Fragment>
  <div class="wrap">
    <nav class="crumbs" aria-label="Breadcrumb"><ol><li><a href={withBase('/')}>Home</a></li><li aria-current="page">{cfg.crumb}</li></ol></nav>
    <header class={`page-hero${cfg.hero ? ' page-hero--split' : ' page-hero--text'}`}>
      <div>
        {eyebrow && <span class="eyebrow eyebrow--rule">{eyebrow}</span>}
        <h1>{h1}</h1>
        {lede && <p class="lede">{lede}</p>}
      </div>
      {cfg.hero && <div class="split__media split__media--room page-hero__media"><Img name={cfg.hero[0]} alt={cfg.hero[1]} sizes="(min-width:1024px) 600px, 100vw" widths={[400, 800, 1200]} eager /></div>}
    </header>
  </div>

  {kind === 'faq' ? (
    <section class="section" style="padding-top:var(--sp-5)" aria-label="Questions and answers">
      <div class="wrap lseo">
        <div class="faq-list">
          {faqAll.map((f, i) => (
            <details class="faq-item" open={i === 0}>
              <summary><span>{f.q}</span></summary>
              <div class="faq-item__a">{f.a.map((x) => <p>{x.replace('843-371-4636', SITE.telDisplay)}</p>)}</div>
            </details>
          ))}
        </div>
        <aside aria-label="Still have a question?">
          <div class="infocard">
            <h2 class="h3">Still have a question?</h2>
            <p class="muted">Our furniture specialists answer the phone themselves, Monday–Saturday, 10 a.m. to 5 p.m.</p>
            <a class="btn btn--caps btn--block" href={`tel:${SITE.tel}`} data-track="click_to_call" data-cta-location="faq_card">Call {SITE.telDisplay}</a>
            <a class="btn btn--caps btn--secondary btn--block" href={withBase('/pages/contact-us')}>Send a message</a>
          </div>
        </aside>
      </div>
    </section>
  ) : kind === 'legal' ? (
    <section class="section" style="padding-top:var(--sp-5)">
      <div class="wrap"><div class="prose legal">
        {sections.map((s) => (
          <Fragment>{s.h && <h2>{s.h}</h2>}<Blocks s={s} cardsAs="prose" /></Fragment>
        ))}
      </div></div>
    </section>
  ) : (
    <Fragment>
      {sections.map((s, i) => {
        const hasCards = s.cards.length > 0;
        const img = i % 2 === 1 ? images.shift() : undefined;
        return (
          <Fragment>
          <section class={`section csec${hasCards ? ' band csec--cards' : ''}`} aria-label={s.h || undefined}>
            <div class="wrap">
              {hasCards ? (
                <Fragment>
                  {(s.h || s.paras.length > 0) && <div class="section-head" data-reveal>{s.eyebrow && <span class="eyebrow">{s.eyebrow}</span>}{s.h && <h2>{s.h}</h2>}{s.paras.length > 0 && <div class="csec__lede prose"><Blocks s={{ ...s, cards: [], faq: [] }} /></div>}</div>}
                  <Blocks s={{ ...s, paras: [] }} cardsAs={cfg.cardsAs ?? 'grid'} />
                </Fragment>
              ) : (
                <div class="csec__grid">
                  <div class="csec__head" data-reveal>{s.eyebrow && <span class="eyebrow">{s.eyebrow}</span>}{s.h && <h2>{s.h}</h2>}</div>
                  <div class="csec__body prose" data-reveal><Blocks s={s} list={cfg.lists?.[s.h]} /></div>
                </div>
              )}
            </div>
          </section>
          {img && <div class="wrap csec__figure"><div class="csec__grid"><span></span><figure data-reveal><Img name={img[0]} alt={img[1]} sizes="(min-width:1280px) 690px, (min-width:1024px) 58vw, 100vw" widths={[400, 800, 1200]} /></figure></div></div>}
          </Fragment>
        );
      })}
      {handle === 'reviews-testimonials' && (
        <Fragment>
          <Reviews count={4} eyebrow="In their words" h="What our customers say" />
          <section class="section" aria-labelledby="review-form-h">
            <div class="wrap split split--7-5" style="align-items:start">
              <div data-reveal><span class="eyebrow eyebrow--rule">Share your story</span><h2 id="review-form-h">Submit your review</h2>
                <p class="lede" style="margin-top:var(--sp-4)">Bought from us? We’d love to hear how it’s going. You can also review us on Google or Facebook.</p></div>
              <div class="form-card">
                <!-- Demo: inert. On the live site this is the Shopify contact form (testimonial). -->
                <form class="form" action="#" method="post" data-form="testimonial" data-demo-form="testimonial" novalidate>
                  <div class="field"><label for="t-name">Name</label><input class="input" id="t-name" name="name" autocomplete="name" /></div>
                  <div class="field"><label for="t-email">Email</label><input class="input" id="t-email" name="email" type="email" autocomplete="email" required aria-describedby="t-email-err" /><span class="field__error" id="t-email-err" hidden>Enter an email so we can reply, like name@example.com.</span></div>
                  <div class="field"><label for="t-photo">Link to a photo <span class="opt">(optional)</span></label><input class="input" id="t-photo" name="photo" type="url" inputmode="url" /></div>
                  <div class="field"><label for="t-msg">Your review</label><textarea class="textarea" id="t-msg" name="message" rows="4"></textarea></div>
                  <button class="btn btn--block" type="submit">Send review</button>
                  <p class="form__status" role="status" tabindex="-1" hidden></p>
                </form>
              </div>
            </div>
          </section>
        </Fragment>
      )}
      {handle === 'careers' && (
        <section class="section band"><div class="wrap cta-band" data-reveal>
          <span class="eyebrow">Apply</span><h2 class="h2">Stop by the showroom or give us a call</h2>
          <p class="lede">We’d love to hear from you. Store hours are Monday–Saturday, 10 a.m. to 5 p.m.</p>
          <div class="btn-row"><a class="btn" href={`tel:${SITE.tel}`} data-track="click_to_call" data-cta-location="careers">Call {SITE.telDisplay}</a><a class="btn btn--secondary" href={withBase('/pages/contact-us')}>Send a message</a></div>
        </div></section>
      )}
    </Fragment>
  )}
  {cfg.visit && <section class="section"><div class="wrap"><Visit loc={`page_${handle}`} /></div></section>}
  </Fragment>
)}
</Base>
