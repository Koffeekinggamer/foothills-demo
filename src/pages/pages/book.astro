---
import Base from '../../layouts/Base.astro';
import Img from '../../components/Img.astro';
import Icon from '../../components/Icon.astro';
import OpenStatus from '../../components/OpenStatus.astro';
import Reviews from '../../components/Reviews.astro';
import Team from '../../components/Team.astro';
import Promise from '../../components/Promise.astro';
import Builders from '../../components/Builders.astro';
import TrustStrip from '../../components/TrustStrip.astro';
import Visit from '../../components/Visit.astro';
import { SITE } from '../../data/site';
import { withBase } from '../../data/url';
// Live booking embed (inert in demo): replace with the real Google Calendar appointment schedule URL.
const CAL_SRC_LIVE = 'https://calendar.google.com/calendar/appointments/schedules/SCHEDULE_ID?gv=true';
const CAL_SRC_DEMO = withBase('/booking-embed-placeholder.html');
const ld = { '@context': 'https://schema.org', '@type': 'WebPage', name: 'Book a showroom appointment', url: `${SITE.origin}/pages/book`,
  potentialAction: { '@type': 'ReserveAction', target: `${SITE.origin}/pages/book`, result: { '@type': 'Reservation', name: 'Furniture design consultation' } }, about: { '@id': `${SITE.origin}/#store` } };
---
<Base title="Book a Showroom Appointment | Foothills Amish Furniture" description="Reserve one-on-one time with a furniture specialist at our Landrum, SC showroom. Bring photos and measurements; we’ll have samples ready." path="/pages/book" bodyClass="page-book" jsonld={[ld]}>
<section class="wrap book-hero" aria-labelledby="book-h">
  <div>
    <span class="eyebrow eyebrow--rule">Book a visit</span>
    <h1 id="book-h">Reserve time with a furniture specialist</h1>
    <p class="lede">Bring your questions, photos and measurements. We’ll set aside dedicated time and have wood, stain and fabric samples ready.</p>
    <p class="book-hero__status"><OpenStatus long /><span>Walk-ins welcome during open hours</span></p>
  </div>
</section>

<section class="section--sm" style="padding-top:0" aria-label="Appointment booking">
  <div class="wrap booking">
    <div>
      <ul class="appt-types" role="list">
        <li class="appt"><h2 class="h4">Furniture design consultation</h2><p>60 min · Landrum showroom</p><a class="btn btn--sm" href="#cal" data-cal-open data-track="book_appointment_click" data-cta-location="booking_furniture">Choose a time</a></li>
        <li class="appt"><h2 class="h4">Custom cabinetry consultation</h2><p>60 min · Landrum showroom</p><a class="btn btn--sm btn--secondary" href="#cal" data-cal-open data-track="book_appointment_click" data-cta-location="booking_cabinetry">Choose a time</a></li>
      </ul>
      <h2 class="h4" style="margin-top:var(--sp-7)">What to expect</h2>
      <ul class="ticks">
        <li>One specialist, one hour, no pressure. Free design help included.</li>
        <li>See and touch woods, stains, paints, fabrics and leathers side by side.</li>
        <li>Get pricing on anything you’d like built to order, in your wood and finish.</li>
      </ul>
      <p class="small muted" style="margin-top:var(--sp-5)">Prefer to call? <a class="link tnum" href={`tel:${SITE.tel}`} data-track="click_to_call" data-cta-location="booking">{SITE.telDisplay}</a></p>
    </div>
    <div class="cal-facade" id="cal" data-facade data-title="Book an appointment with Foothills Amish Furniture" data-src={CAL_SRC_DEMO} data-live-src={CAL_SRC_LIVE}>
      <div class="cal-facade__inner">
        <Icon name="cal" class="cal" />
        <h2 class="h3">See open times</h2>
        <p class="muted">Times come from our Google Calendar. You’ll get a confirmation email right away. The calendar loads only when you ask for it.</p>
        <button class="btn" type="button" data-track="book_appointment_click" data-cta-location="booking_embed">Show available times</button>
      </div>
    </div>
  </div>
</section>

<section class="section--sm"><div class="wrap"><TrustStrip /></div></section>

<section class="section" aria-labelledby="rooms-h">
  <div class="wrap">
    <div class="section-head" data-reveal><span class="eyebrow">The showroom</span><h2 id="rooms-h">Rooms you can walk through</h2></div>
    <div class="room-strip">
      <figure data-reveal style="--i:0"><Img name="showroom-living" alt="Living room set in the showroom" sizes="(min-width:1024px) 410px, (min-width:768px) 31vw, 100vw" widths={[400, 800]} /><figcaption>Living</figcaption></figure>
      <figure data-reveal style="--i:1"><Img name="p-barrel-amish-solid-wood-dining-collection-0" alt="Barrel solid wood dining set in a dining room" sizes="(min-width:1024px) 410px, (min-width:768px) 31vw, 100vw" widths={[400, 800]} /><figcaption>Dining</figcaption></figure>
      <figure data-reveal style="--i:2"><Img name="cat-amish-furniture-bedroom-furniture2" alt="Bedroom set with four-poster bed in the showroom" sizes="(min-width:1024px) 410px, (min-width:768px) 31vw, 100vw" widths={[400, 800]} /><figcaption>Bedroom</figcaption></figure>
    </div>
  </div>
</section>

<Team />
<Reviews count={3} />
<Builders />
<Promise />
<section class="section band" id="visit"><div class="wrap"><Visit h="Find the showroom" eyebrow="Plan your visit" loc="booking_visit" /></div></section>
</Base>
