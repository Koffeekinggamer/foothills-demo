---
import Base from '../../layouts/Base.astro';
import Img from '../../components/Img.astro';
import Icon from '../../components/Icon.astro';
import OpenStatus from '../../components/OpenStatus.astro';
import ProductCard from '../../components/ProductCard.astro';
import Reviews from '../../components/Reviews.astro';
import Promise from '../../components/Promise.astro';
import Team from '../../components/Team.astro';
import TrustStrip from '../../components/TrustStrip.astro';
import { SITE } from '../../data/site';
import { withBase } from '../../data/url';
import { COLLECTIONS, COLLECTION, items as itemsOf, woodLabel, type Coll } from '../../data/catalog';
import { productLd } from '../../data/ld';
import { heroFor } from '../../data/collhero';
import { strip, lede as ledeOf, cleanHtml } from '../../data/text';

export function getStaticPaths() { return Object.values(COLLECTIONS).map((c) => ({ params: { handle: c.handle }, props: { c } })); }
const { c } = Astro.props as { c: Coll };
const parent = c.parent ? COLLECTIONS[c.parent] : null;
const room = parent ?? c;
const items = itemsOf(c.handle);
const isBenches = c.handle === 'dining-benches';
const siblings = (room.children ?? []).map((h) => COLLECTIONS[h]);
const subIndex = parent ? (parent.children ?? []).indexOf(c.handle) : 0;
const [heroImg, heroAlt] = heroFor(c.handle, c.parent, subIndex);
const noun = isBenches ? 'benches' : 'pieces';
const title = isBenches ? COLLECTION.title : c.title;
const lede = isBenches ? COLLECTION.lede : ledeOf(c.description) || `${c.title}, handcrafted by Amish workshops and built to order in your choice of wood and finish.`;
const label = (h: string | undefined) => (h && COLLECTIONS[h] ? COLLECTIONS[h].label : '');

function counts(get: (p: typeof items[number]) => string[]) {
  const m = new Map<string, number>();
  items.forEach((p) => get(p).forEach((v) => v && m.set(v, (m.get(v) || 0) + 1)));
  return [...m.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
}
const allFacets = [
  ...(parent ? [] : [{ key: 'type', title: 'Category', opts: counts((p) => [label(p.primary)]) }]),
  { key: 'builder', title: 'Builder', opts: counts((p) => [p.vendor]) },
  { key: 'wood', title: 'Wood (as shown)', opts: counts((p) => [woodLabel(p.wood)]) },
  { key: 'room', title: 'Room', opts: counts((p) => p.rooms) },
];
// Benches keep all three facets as approved; elsewhere a facet with one value is noise.
const facets = isBenches ? allFacets : allFacets.filter((f) => f.opts.length > 1);
const keys = facets.map((f) => f.key).join(',');
const sample = items.length < c.total;
const ld = { '@context': 'https://schema.org', '@type': 'CollectionPage', name: title, url: `${SITE.origin}/collections/${c.handle}`,
  mainEntity: { '@type': 'ItemList', numberOfItems: items.length, itemListElement: items.map((p, i) => ({ '@type': 'ListItem', position: i + 1, item: productLd(p) })) } };
const crumbList = [{ name: 'Home', path: '/' }, ...(parent ? [{ name: parent.label, path: `/collections/${parent.handle}` }] : []), { name: parent ? c.label : title, path: `/collections/${c.handle}` }];
const crumbs = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: crumbList.map((x, i) => ({ '@type': 'ListItem', position: i + 1, name: x.name, item: SITE.origin + x.path })) };
const desc = isBenches ? '' : cleanHtml(c.description, 6);
const metaDesc = isBenches
  ? 'Amish dining benches in solid hardwood and reclaimed barnwood: trestle, storage and backed benches built to order to match your table. Landrum, SC showroom.'
  : `${lede.slice(0, 120).replace(/\s+\S*$/, '')}. Built to order by Amish workshops. See them at our Landrum, SC showroom.`.replace('..', '.');
const help = isBenches
  ? { h: 'Matching a bench to your table?', p: 'Bring your table length and finish, or a photo. We’ll match wood, stain and size in the showroom, and most benches are built to order.' }
  : { h: `Don’t see the one you have in mind?`, p: `This is a selection${sample ? ` of ${items.length} from our ${c.total} ${parent ? c.label.toLowerCase() : `${room.label.toLowerCase()} pieces`}` : ''}. Most pieces can be built in another wood, stain or size, and we can order from every builder’s full catalog. Bring a photo or a measurement.` };
---
<Base title={`${title} | Foothills Amish Furniture`} description={metaDesc} path={`/collections/${c.handle}`} nav={isBenches ? 'Benches' : room.label} bodyClass="page-collection" lcp={{ name: heroImg, sizes: '(min-width:1024px) 560px, 100vw', widths: [400, 800, 1200] }} jsonld={[ld, crumbs]}>
<div class="wrap">
  <nav class="crumbs" aria-label="Breadcrumb"><ol>{crumbList.map((x, i) => i < crumbList.length - 1 ? <li><a href={withBase(x.path)}>{x.name}</a></li> : <li aria-current="page">{x.name}</li>)}</ol></nav>
  <header class="coll-hero">
    <div class="coll-hero__copy">
      <h1>{title}</h1>
      <p class="lede">{lede}</p>
      <p class="coll-hero__meta"><OpenStatus /><span>Many on display at {SITE.street}</span></p>
    </div>
    <div class="coll-hero__media"><Img name={heroImg} alt={heroAlt} sizes="(min-width:1024px) 560px, 100vw" widths={[400, 800, 1200]} eager /></div>
  </header>

  {siblings.length > 0 && (
    <nav class="cat-nav" aria-label={`${room.label} categories`}>
      <ul class="chips chips--scroll" role="list">
        <li><a class={`chip${!parent ? ' is-active' : ''}`} href={withBase(`/collections/${room.handle}`)} aria-current={!parent ? 'page' : undefined}>All {room.label.toLowerCase()}</a></li>
        {siblings.map((s) => <li><a class={`chip${s.handle === c.handle ? ' is-active' : ''}`} href={withBase(`/collections/${s.handle}`)} aria-current={s.handle === c.handle ? 'page' : undefined}>{s.label}</a></li>)}
      </ul>
    </nav>
  )}

  <div class="coll" data-coll data-keys={keys}>
    <aside class="rail" id="filters" aria-label="Filters">
      <div class="rail__head"><h2 class="h4">Filter</h2><button class="link rail__clear" type="button" data-clear hidden>Clear all</button><button class="icon-btn rail__close" type="button" aria-label="Close filters" data-filters-toggle><Icon name="close" /></button></div>
      {facets.map((f) => (
        <details class="facet" open>
          <summary>{f.title}</summary>
          <ul>{f.opts.map(([v, n]) => (
            <li><label class="check"><input type="checkbox" name={f.key} value={v} /> {v}<span class="n tnum" data-count>{n}</span></label></li>
          ))}</ul>
        </details>
      ))}
      <button class="btn btn--block rail__done" type="button" data-filters-toggle>Show <span data-count-total>{items.length}</span> {noun}</button>
    </aside>
    <div>
      <div class="coll-search">
        <label class="sr-only" for="q">Search {title.replace(/^Amish /, '').toLowerCase()}</label>
        <Icon name="search" />
        <input class="input" id="q" type="search" placeholder={`Search ${items.length} ${noun}`} autocomplete="off" enterkeyhint="search" />
      </div>
      <div class="toolbar">
        <button class="filter-btn" type="button" aria-controls="filters" aria-expanded="false" data-filters-toggle><Icon name="filter" />Filter <span class="count" data-active-count hidden>0</span></button>
        <span class="toolbar__count tnum" aria-live="polite"><span data-count-shown>{items.length}</span> pieces{sample && <span class="toolbar__of"> of {c.total}</span>}</span>
        <label><span class="sr-only">Sort</span><select class="select" data-sort><option value="featured">Featured</option><option value="az">Name, A–Z</option><option value="new">Newest</option></select></label>
      </div>
      <div class="active-chips" data-chips hidden></div>
      <ul class="pgrid pgrid--3" role="list" data-grid>
        {items.map((p, i) => (
          <li data-i={i} data-name={p.title} data-created={p.created} data-builder={p.vendor} data-wood={woodLabel(p.wood)} data-room={p.rooms.join('|')} data-type={label(p.primary)}
              data-text={`${p.title} ${p.vendor} ${woodLabel(p.wood)} ${p.rooms.join(' ')} ${p.type || ''} ${label(p.primary)} ${p.collection || ''} ${strip(p.body_html || [...p.paras, ...(p.bullets || [])].join(' ')).slice(0, 600)}`.toLowerCase()}>
            <ProductCard p={p} eager={i < 2} />
          </li>
        ))}
      </ul>
      <div class="empty" data-empty hidden>
        <h2 class="h3">{isBenches ? 'No benches match that yet' : 'Nothing here matches that yet'}</h2>
        <p class="muted">{isBenches ? 'Most of our benches can be built in any wood and size. Tell us what you have in mind.' : 'Most pieces can be built in any wood, finish and size, and we can order from each builder’s full catalog. Tell us what you have in mind.'}</p>
        <div class="btn-row"><button class="btn btn--secondary" type="button" data-clear>Clear search &amp; filters</button><a class="btn" href={`tel:${SITE.tel}`} data-track="click_to_call" data-cta-location="collection_empty">Call {SITE.telDisplay}</a></div>
      </div>
    </div>
  </div>

  <section class="coll-help" data-reveal>
    <div><h2 class="h3">{help.h}</h2><p class="muted" style="margin-top:var(--sp-2)">{help.p}</p></div>
    <div class="btn-row"><a class="btn" href={SITE.book} data-track="book_appointment_click" data-cta-location="collection_help">Book a visit</a><a class="btn btn--secondary" href={`tel:${SITE.tel}`} data-track="click_to_call" data-cta-location="collection_help">Call {SITE.telDisplay}</a></div>
  </section>
</div>

<section class="section--sm"><div class="wrap"><TrustStrip /></div></section>
<Reviews count={3} h={`What customers say about our ${room.label.toLowerCase()} furniture`} />
<Promise />
<Team />

<section class="section--sm"><div class="wrap prose" data-cms={`collections/${c.handle}.description`}>
  {isBenches ? (
    <Fragment><h2>Amish dining benches, built to order</h2>
    <p class="muted">A bench seats more people in less space and slides neatly under the table when it isn’t in use. Our Amish dining benches come in trestle, mission, storage and backed styles, in solid hardwoods like brown maple, cherry and quarter-sawn white oak, or in reclaimed barnwood from century-old Ohio barns. Most can be sized to your table and finished to match.</p></Fragment>
  ) : desc ? <Fragment set:html={desc} /> : <Fragment><h2>{c.title}, built to order</h2><p>{lede}</p></Fragment>}
</div></section>

<script is:inline src={withBase('/collection.js')} defer></script>
</Base>
