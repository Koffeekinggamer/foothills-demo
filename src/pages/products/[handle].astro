---
import Base from '../../layouts/Base.astro';
import Img from '../../components/Img.astro';
import Icon from '../../components/Icon.astro';
import OpenStatus from '../../components/OpenStatus.astro';
import ProductCard from '../../components/ProductCard.astro';
import Reviews from '../../components/Reviews.astro';
import Builders from '../../components/Builders.astro';
import Promise from '../../components/Promise.astro';
import Team from '../../components/Team.astro';
import TrustStrip from '../../components/TrustStrip.astro';
import { SITE } from '../../data/site';
import { withBase } from '../../data/url';
import { BENCHES, COLLECTION, woodLabel, type Piece } from '../../data/catalog';
import { productLd } from '../../data/ld';

export function getStaticPaths() { return BENCHES.map((p) => ({ params: { handle: p.handle }, props: { p } })); }
const { p } = Astro.props as { p: Piece };

const rooms: [string, string][] = p.vendor === 'Urban Barnwood'
  ? [['p-almanzo-amish-reclaimed-wood-dining-collection-0', 'Urban Barnwood Almanzo reclaimed wood dining set in a dining room'], ['p-amish-reclaimed-barnwood-1869-dining-collection-0', 'Reclaimed barnwood 1869 dining set with bench in a dining room']]
  : [['p-barrel-amish-solid-wood-dining-collection-0', 'Solid wood dining set styled in a dining room'], ['showroom-interior', 'Dining and living furniture on the Landrum showroom floor']];
const gallery: { name: string; alt: string; room: boolean }[] = [{ name: p.image, alt: `${p.title}, ${woodLabel(p.wood).toLowerCase()}`, room: false }, ...rooms.map(([name, alt]) => ({ name, alt, room: true }))];
const related = BENCHES.filter((b) => b.handle !== p.handle && b.vendor === p.vendor).slice(0, 4);
const rel = related.length >= 4 ? related : [...related, ...BENCHES.filter((b) => b.handle !== p.handle && b.vendor !== p.vendor)].slice(0, 4);
const ld = { '@context': 'https://schema.org', ...productLd(p) };
const crumbs = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
  { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.origin + '/' },
  { '@type': 'ListItem', position: 2, name: COLLECTION.title, item: `${SITE.origin}/collections/${COLLECTION.handle}` },
  { '@type': 'ListItem', position: 3, name: p.title, item: `${SITE.origin}/products/${p.handle}` } ] };
const opts = (p.dims || '').replace(/^(Dimensions( & Options)?|Sizes?)\s*:?\s*/i, '');
const isSpec = (t: string) => /\d+(\.\d+)?\s*["”″]\s*(W|D|H|x|Long|L\b)/i.test(t) || /^(Available|Pictured|SKU)/i.test(t);
const descParas = p.paras.filter((t) => !isSpec(t)).slice(0, 2);
const specParas = p.paras.filter(isSpec).slice(0, 2);
const shortTitle = p.title.replace(/^Amish\s+/i, '');
---
<Base title={`${p.title} | Foothills Amish Furniture`} description={`${p.title} by ${p.vendor}. Amish-made, built to order in your choice of wood and finish. See it at our Landrum, SC showroom.`} path={`/products/${p.handle}`} nav="Benches" bodyClass="page-product" product={p.handle} lcp={{ name: p.image, sizes: '(min-width:1024px) 54vw, 100vw' }} jsonld={[ld, crumbs]}>
<div class="wrap">
  <nav class="crumbs" aria-label="Breadcrumb"><ol><li><a href={withBase('/')}>Home</a></li><li><a href={withBase(`/collections/${COLLECTION.handle}`)}>Dining benches</a></li><li aria-current="page">{p.title}</li></ol></nav>
  <div class="pdp">
    <div class="gallery">
      <div class="gallery__main"><Img name={gallery[0].name} alt={gallery[0].alt} sizes="(min-width:1024px) 54vw, 100vw" eager /></div>
      {gallery.map((g, i) => <template id={`gallery-${i}`}><Img name={g.name} alt={g.alt} sizes="(min-width:1024px) 54vw, 100vw" /></template>)}
      <ul class="gallery__thumbs" role="list">
        {gallery.map((g, i) => <li><button type="button" aria-label={`Show image ${i + 1}: ${g.room ? 'room photo' : 'product photo'}`} aria-current={i === 0 ? 'true' : undefined} data-room={g.room ? '' : undefined} class={g.room ? 'is-room' : undefined}><Img name={g.name} alt="" sizes="120px" widths={[400]} /></button></li>)}
      </ul>
      <p class="gallery__note small muted">Room photos show similar Amish dining furniture styled in a home and in our showroom.</p>
    </div>
    <div class="pdp__info">
      <span class="eyebrow">Dining · Benches</span>
      <h1 class="h1">{p.title}</h1>
      <p class="pdp__maker">By {p.vendor}{p.collection ? ` · ${p.collection}` : ''}</p>
      <div class="pdp__ctas">
        <a class="btn btn--block" href="#request" data-request-info data-track="request_info_click" data-cta-location="pdp">Request info on this piece</a>
        <a class="btn btn--secondary btn--block" href={SITE.book} data-track="book_appointment_click" data-cta-location="pdp">Book a showroom visit</a>
        <div class="pdp__alt">
          <a href={`tel:${SITE.tel}`} data-track="click_to_call" data-cta-location="pdp"><Icon name="phone" />Call</a>
          <a href={SITE.sms} data-podium data-track="text_us_click" data-cta-location="pdp"><Icon name="chat" />Text</a>
          <a href={SITE.directions} target="_blank" rel="noopener" data-track="directions_click" data-cta-location="pdp"><Icon name="pin" />Directions</a>
        </div>
      </div>
      <p class="pdp__status"><OpenStatus /><span>See benches like this at {SITE.street}, Landrum</span></p>
      <p class="pdp__note">Built to order in solid wood by an Amish workshop. Choose your wood, stain or paint, and size. Pricing depends on your options, so ask us for a quote.</p>
      <dl class="specs">
        <div><dt>Builder</dt><dd>{p.vendor}</dd></div>
        <div><dt>Wood (shown)</dt><dd>{woodLabel(p.wood)}</dd></div>
        {opts && <div><dt>Sizes</dt><dd class="tnum">{opts}</dd></div>}
        <div><dt>Rooms</dt><dd>{p.rooms.join(', ')}</dd></div>
        {specParas.map((t) => <div><dt>Details</dt><dd>{t}</dd></div>)}
        <div><dt>Lead time</dt><dd>Built to order; we confirm timing with your quote</dd></div>
      </dl>
      {descParas.length > 0 && <div class="pdp__desc">{descParas.map((t) => <p>{t}</p>)}</div>}
      <TrustStrip />
    </div>
  </div>
</div>

<section class="section band" id="request" style="margin-top:var(--section-y)" aria-labelledby="request-h">
  <div class="wrap split split--7-5" style="align-items:start">
    <div data-reveal>
      <span class="eyebrow eyebrow--rule">Request info</span>
      <h2 id="request-h">Ask about the {shortTitle}</h2>
      <p class="lede" style="margin-top:var(--sp-4)">Sizes, woods, finishes or a quote. A furniture specialist replies within one business day. Prefer to talk? Call <a class="link tnum" href={`tel:${SITE.tel}`} data-track="click_to_call" data-cta-location="pdp_form">{SITE.telDisplay}</a>.</p>
      <dl class="visit__facts">
        <div><dt>See it in person</dt><dd>{SITE.address}<br /><OpenStatus /></dd></div>
      </dl>
    </div>
    <div class="form-card">
      <form class="form" id="contact_form" action="#" method="post" data-form="product_inquiry" data-demo-form="request" novalidate>
        <div class="prefill"><Img name={p.image} alt="" sizes="48px" widths={[400]} /><div><span class="muted">About</span><br /><strong>{p.title}</strong></div></div>
        <input type="hidden" name="product_title" value={p.title} /><input type="hidden" name="product_handle" value={p.handle} /><input type="hidden" name="form_id" value="contact_form" />
        <div class="field"><label for="f-name">Name</label><input class="input" id="f-name" name="name" autocomplete="name" /></div>
        <div class="field"><label for="f-email">Email</label><input class="input" id="f-email" name="email" type="email" autocomplete="email" required aria-describedby="f-email-err" /><span class="field__error" id="f-email-err" hidden>Enter an email so we can reply, like name@example.com.</span></div>
        <div class="field"><label for="f-phone">Phone <span class="opt">(optional)</span></label><input class="input" id="f-phone" name="phone" type="tel" autocomplete="tel" /></div>
        <div class="field"><label for="f-msg">What would you like to know?</label><textarea class="textarea" id="f-msg" name="message" rows="3">I’m interested in the {p.title}. </textarea></div>
        <button class="btn btn--block" type="submit">Send request</button>
        <p class="form__status" role="status" tabindex="-1" hidden></p>
      </form>
    </div>
  </div>
</section>

<section class="section" aria-labelledby="rel-h">
  <div class="wrap">
    <div class="section-head section-head--row" data-reveal><div><span class="eyebrow">{p.vendor}</span><h2 id="rel-h">More benches</h2></div><a class="textlink" href={withBase(`/collections/${COLLECTION.handle}`)}>All dining benches <span class="arrow" aria-hidden="true">→</span></a></div>
    <ul class="pgrid pgrid--4" role="list">{rel.map((r, i) => <li data-reveal style={`--i:${i}`}><ProductCard p={r} /></li>)}</ul>
  </div>
</section>
<Builders highlight={p.vendor} />
<Reviews count={3} />
<Promise />
<Team />
</Base>
